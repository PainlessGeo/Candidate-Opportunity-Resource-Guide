{
  "version": 2,
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "functions": {
    "api/generate-briefing.js": {
      "maxDuration": 280
    },
    "api/export-docx.js": {
      "maxDuration": 30
    },
    "api/export-pdf.js": {
      "maxDuration": 30
    }
  }
}
